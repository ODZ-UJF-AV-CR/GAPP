{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ESNext", "DOM"],
        "declaration": true,
        "declarationMap": true,
        "isolatedDeclarations": false,
        "sourceMap": true,
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "rootDir": "./src",
        "types": ["node"]
    },
    "include": ["./src"],
    "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
