{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "!README.md"]
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "interruptible": true
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": []
        }
    },
    "globalPassThroughEnv": ["POSTGRES_URL"]
}
